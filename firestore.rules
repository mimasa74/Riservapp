rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'michele.bruni@gmail.com';
    }

    // config/main: lettura per utenti autenticati (anche anonimi), scrittura solo admin
    match /config/main {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // posts: lettura per autenticati (blocca scraping via API).
    // creazione/eliminazione: SOLO admin — l'identità "direttivo" non è verificabile
    //   con auth anonima, quindi la vecchia regola basata su request.resource.data.autore
    //   era spoofabile da qualsiasi client (post 'alert' → push a tutti i soci).
    //   I post di sistema (quota/sospeso/chiuso) li scrive la Cloud Function via Admin SDK,
    //   che bypassa le rules.
    // aggiornamento: solo il campo 'letti', e solo in append (non si possono togliere nomi)
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letti']) &&
        request.resource.data.letti is list &&
        request.resource.data.letti.hasAll(resource.data.get('letti', []))
      );
    }

    // fcm_tokens: il dispositivo può scrivere/aggiornare solo il proprio documento
    // (auth anonima obbligatoria + deviceId nel body == deviceId nel path + schema minimo)
    // lettura e delete solo admin (anon auth NON deve vedere token altrui)
    match /fcm_tokens/{deviceId} {
      allow create, update: if isAuthenticated() &&
        request.resource.data.deviceId == deviceId &&
        request.resource.data.token is string &&
        request.resource.data.nome is string;
      allow delete: if isAdmin();
      allow read: if isAdmin();
    }

    // user_locations: il dispositivo può scrivere/aggiornare solo il proprio documento
    // DELETE: dispositivo può eliminare solo il proprio (deviceId match)
    // lettura solo admin (anon auth NON deve vedere posizioni altrui)
    match /user_locations/{deviceId} {
      allow create, update: if isAuthenticated() &&
        request.resource.data.deviceId == deviceId &&
        request.resource.data.lat is number &&
        request.resource.data.lng is number;
      allow delete: if isAuthenticated() && resource != null && resource.data.deviceId == deviceId;
      allow read: if isAdmin();
    }

    // geofences: lettura per autenticati (serve al client per geofencing),
    // scrittura solo admin
    match /geofences/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // config/members: lista soci — lettura per autenticati, scrittura solo admin
    match /config/members {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // config/slots: mappa normalizedName → deviceId.
    // Slot libero = chiave ASSENTE (l'admin libera con deleteField, non con null).
    // Un socio può SOLO aggiungere una chiave nuova (rivendicare uno slot libero),
    // una alla volta: niente furto di slot occupati, niente wipe del documento.
    match /config/slots {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).addedKeys().size() == 1 &&
        request.resource.data.diff(resource.data).changedKeys().size() == 0 &&
        request.resource.data.diff(resource.data).removedKeys().size() == 0
      );
    }

    // config/onboarding_reset: lista di deviceId che devono rifare l'onboarding.
    // Admin aggiunge; un dispositivo può solo RIMUOVERE id dalla lista (il proprio):
    // la nuova lista deve essere un sottoinsieme della vecchia.
    match /config/onboarding_reset {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.keys().hasOnly(['deviceIds']) &&
        request.resource.data.deviceIds is list &&
        resource.data.get('deviceIds', []).hasAll(request.resource.data.deviceIds)
      );
    }
  }
}
