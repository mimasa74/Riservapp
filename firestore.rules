rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'michele.bruni@gmail.com';
    }

    // config/main: lettura per utenti autenticati (anche anonimi), scrittura solo admin
    match /config/main {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // posts: lettura per autenticati (blocca scraping via API).
    // creazione: admin o membro del direttivo (verificato contro config/members)
    // eliminazione: solo admin. L'utente anonimo non può provare la propria identità
    //   quindi il direttivo che cancella dalla UI lo fa dopo long-press + login Google.
    // aggiornamento campo 'letti': permesso a tutti gli autenticati
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() ||
        get(/databases/$(database)/documents/config/members).data.direttivo.hasAny([request.resource.data.autore]);
      allow delete: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letti']));
    }

    // fcm_tokens: il dispositivo può scrivere/aggiornare solo il proprio documento
    // (verificato tramite deviceId nel body == deviceId nel path)
    // lettura e delete solo admin (anon auth NON deve vedere token altrui)
    match /fcm_tokens/{deviceId} {
      allow create, update: if request.resource.data.deviceId == deviceId;
      allow delete: if isAdmin();
      allow read: if isAdmin();
    }

    // user_locations: il dispositivo può scrivere/aggiornare solo il proprio documento
    // DELETE: dispositivo può eliminare solo il proprio (deviceId match)
    // lettura solo admin (anon auth NON deve vedere posizioni altrui)
    match /user_locations/{deviceId} {
      allow create, update: if request.resource.data.deviceId == deviceId;
      allow delete: if resource != null && resource.data.deviceId == deviceId;
      allow read: if isAdmin();
    }

    // geofences: lettura per autenticati (serve al client per geofencing),
    // scrittura solo admin
    match /geofences/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // config/members: lista soci — lettura per autenticati, scrittura solo admin
    match /config/members {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // config/ospite: deprecato, sostituito da config/slots
    match /config/ospite {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // config/slots: mappa normalizedName → deviceId — lettura e scrittura per autenticati.
    // Ogni slot è occupato da un solo dispositivo.
    match /config/slots {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // config/onboarding_reset: lista di deviceId che devono rifare l'onboarding
    // scrittura admin (aggiunge) o autenticata (il dispositivo si rimuove dalla lista)
    match /config/onboarding_reset {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
