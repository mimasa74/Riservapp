rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'michele.bruni@gmail.com';
    }

    // config/main: lettura per utenti autenticati (anche anonimi), scrittura solo admin
    match /config/main {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // posts: lettura per autenticati (blocca scraping via API).
    // creazione/eliminazione: SOLO admin — l'identità "direttivo" non è verificabile
    //   con auth anonima, quindi la vecchia regola basata su request.resource.data.autore
    //   era spoofabile da qualsiasi client (post 'alert' → push a tutti i soci).
    //   I post di sistema (quota/sospeso/chiuso) li scrive la Cloud Function via Admin SDK,
    //   che bypassa le rules.
    // aggiornamento: solo il campo 'letti', e solo in append (non si possono togliere nomi)
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letti']) &&
        request.resource.data.letti is list &&
        request.resource.data.letti.hasAll(resource.data.get('letti', []))
      );
    }

    // fcm_tokens: il dispositivo può scrivere/aggiornare solo il proprio documento
    // (auth anonima obbligatoria + deviceId nel body == deviceId nel path + schema minimo)
    // lettura e delete solo admin (anon auth NON deve vedere token altrui)
    match /fcm_tokens/{deviceId} {
      allow create, update: if isAuthenticated() &&
        request.resource.data.deviceId == deviceId &&
        request.resource.data.token is string &&
        request.resource.data.nome is string;
      allow delete: if isAdmin();
      allow read: if isAdmin();
    }

    // Destinatario privato: il token stesso è protetto, non un riferimento ai
    // fcm_tokens pubblicamente scrivibili. Solo Google verificato di Michele.
    match /config/rettore_push {
      function isRettoreGoogle() {
        return isAdmin() && request.auth.token.email_verified == true &&
          request.auth.token.firebase.sign_in_provider == 'google.com';
      }
      allow read, delete: if isRettoreGoogle();
      allow create, update: if isRettoreGoogle() &&
        request.resource.data.keys().hasOnly(['uid', 'deviceId', 'token', 'sessionId']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.deviceId is string &&
        request.resource.data.deviceId.size() > 0 && request.resource.data.deviceId.size() <= 100 &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096 &&
        request.resource.data.sessionId is string && request.resource.data.sessionId.size() == 36;
    }

    // user_locations: un documento per punto, id automatico (la scia).
    // Il client può SOLO creare: i punti li cancella la pulizia sul server dopo
    // 35 minuti, nessuno li modifica. Niente confronto fra deviceId e id del
    // documento — con l'id automatico non avrebbe più senso — al suo posto i
    // tipi dei campi e la lunghezza delle stringhe.
    // Lettura solo admin (anon auth NON deve vedere posizioni altrui).
    match /user_locations/{pointId} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['deviceId', 'nome', 'lat', 'lng', 'timestamp']) &&
        request.resource.data.deviceId is string &&
        request.resource.data.deviceId.size() > 0 &&
        request.resource.data.deviceId.size() <= 100 &&
        request.resource.data.nome is string &&
        request.resource.data.nome.size() > 0 &&
        request.resource.data.nome.size() <= 80 &&
        request.resource.data.lat is number &&
        request.resource.data.lat >= -90 && request.resource.data.lat <= 90 &&
        request.resource.data.lng is number &&
        request.resource.data.lng >= -180 && request.resource.data.lng <= 180 &&
        request.resource.data.timestamp is timestamp &&
        request.resource.data.timestamp == request.time;
      allow update, delete: if false;
      allow read: if isAdmin();
    }

    // geofences: lettura per autenticati (serve al client per geofencing),
    // scrittura solo admin
    match /geofences/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // config/members: lista soci — lettura per autenticati, scrittura solo admin
    match /config/members {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // config/slots: mappa normalizedName → deviceId.
    // Slot libero = chiave ASSENTE (l'admin libera con deleteField, non con null).
    // Un socio può SOLO aggiungere una chiave nuova (rivendicare uno slot libero),
    // una alla volta: niente furto di slot occupati, niente wipe del documento.
    match /config/slots {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).addedKeys().size() == 1 &&
        request.resource.data.diff(resource.data).changedKeys().size() == 0 &&
        request.resource.data.diff(resource.data).removedKeys().size() == 0
      );
    }

    // config/onboarding_reset: lista di deviceId che devono rifare l'onboarding.
    // Admin aggiunge; un dispositivo può solo RIMUOVERE id dalla lista (il proprio):
    // la nuova lista deve essere un sottoinsieme della vecchia.
    // config/note_rettore: diario privato del Rettore, { specieId: NotaRettore[] }.
    // Documento a parte apposta: config/main lo scarica per intero ogni dispositivo
    // autenticato, quindi nasconderlo nella UI non lo renderebbe privato. Qui il
    // socio non ha nemmeno il permesso di leggere, e il client non lo sottoscrive.
    match /config/note_rettore {
      allow read, write: if isAdmin();
    }

    // config/avviso_piano: memoria dell'avviso di aggiornamento del piano —
    // capi in attesa di essere annunciati, ora dell'ultima crocetta, ora
    // dell'ultimo invio. Nessun client la tocca, nemmeno l'admin: la scrive e
    // la legge solo la Cloud Function, che passa dall'Admin SDK e bypassa le
    // rules. Vietarla esplicitamente evita che un domani qualcuno la apra
    // "tanto è innocua": manometterla vorrebbe dire far partire una notifica a
    // tutti i soci, o zittirla per sempre.
    match /config/avviso_piano {
      allow read, write: if false;
    }

    match /config/onboarding_reset {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.keys().hasOnly(['deviceIds']) &&
        request.resource.data.deviceIds is list &&
        resource.data.get('deviceIds', []).hasAll(request.resource.data.deviceIds)
      );
    }
  }
}
