rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'michele.bruni@gmail.com';
    }

    // config/main: lettura pubblica, scrittura solo admin
    match /config/main {
      allow read: if true;
      allow write: if isAdmin();
    }

    // posts: lettura pubblica
    // creazione: admin o membro del direttivo (verificato contro config/members)
    // eliminazione: pubblica — senza auth Google per il direttivo non è possibile verificare
    // l'identità lato server. Il cestino è visibile solo ad admin e direttivo nell'UI.
    // Accettabile per app interna con 45 utenti.
    // aggiornamento campo 'letti': permesso a tutti
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() ||
        get(/databases/$(database)/documents/config/members).data.direttivo.hasAny([request.resource.data.autore]);
      allow delete: if true;
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letti']);
    }

    // fcm_tokens: il dispositivo può scrivere/aggiornare solo il proprio documento
    // (verificato tramite deviceId nel body == deviceId nel path)
    // lettura solo admin
    match /fcm_tokens/{deviceId} {
      allow create, update: if request.resource.data.deviceId == deviceId;
      allow delete: if isAuthenticated();
      allow read: if isAuthenticated();
    }

    // user_locations: il dispositivo può scrivere/aggiornare solo il proprio documento
    // DELETE: controlla resource.data.deviceId (non request.resource che è null su delete)
    // lettura solo admin
    match /user_locations/{deviceId} {
      allow create, update: if request.resource.data.deviceId == deviceId;
      allow delete: if resource != null && resource.data.deviceId == deviceId;
      allow read: if isAuthenticated();
    }

    // geofences: lettura pubblica (serve al client per geofencing),
    // scrittura solo admin
    match /geofences/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // config/members: lista soci — lettura pubblica, scrittura solo admin
    match /config/members {
      allow read: if true;
      allow write: if isAdmin();
    }

    // config/ospite: deprecato, sostituito da config/slots
    match /config/ospite {
      allow read: if true;
      allow write: if true;
    }

    // config/slots: mappa normalizedName → deviceId — lettura e scrittura pubblica
    // ogni slot è occupato da un solo dispositivo
    match /config/slots {
      allow read: if true;
      allow write: if true;
    }

    // config/onboarding_reset: lista di deviceId che devono rifare l'onboarding
    // scrittura admin (aggiunge) o pubblica (il dispositivo si rimuove dalla lista)
    match /config/onboarding_reset {
      allow read: if true;
      allow write: if true;
    }
  }
}
